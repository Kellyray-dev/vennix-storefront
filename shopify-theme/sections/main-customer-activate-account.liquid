<section class="auth page-width">
  <div class="auth__panel">
    <p class="eyebrow">{{ 'customer.activate_account.eyebrow' | t }}</p>
    <h1>{{ 'customer.activate_account.title' | t }}</h1>
    <p class="auth__lead">{{ 'customer.activate_account.subtext' | t }}</p>

    {%- form 'activate_customer_password', class: 'auth__form' -%}
      {%- if form.errors -%}
        <p class="form-msg is-error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="field">
        <label for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
        <input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ActivateConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input id="ActivateConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <div class="auth__row">
        <button class="button button--primary button--lg" type="submit" name="commit">{{ 'customer.activate_account.submit' | t }}</button>
        <button class="button button--ghost" type="submit" name="decline">{{ 'customer.activate_account.decline' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
