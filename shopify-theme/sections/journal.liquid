{%- assign blog = blogs[section.settings.blog] -%}
<section class="journal">
  <div class="page-width">
    <div class="section-head">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if blog != blank -%}
        <a class="link-arrow" href="{{ blog.url }}">{{ 'blogs.read_all' | t }} {% render 'icon', name: 'arrow', size: 15 %}</a>
      {%- endif -%}
    </div>

    {%- if blog != blank and blog.articles.size > 0 -%}
      <ul class="journal__list">
        {%- for article in blog.articles limit: section.settings.posts_to_show -%}
          <li class="post-card">
            <a href="{{ article.url }}">
              <span class="post-card__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </span>
              <span class="post-card__body">
                <span class="post-card__meta">
                  <span class="post-card__tag">{{ article.tags.first | default: section.settings.default_tag }}</span>
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %b %Y' }}</time>
                </span>
                <strong class="post-card__title">{{ article.title }}</strong>
                <span class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</span>
                <span class="link-arrow">{{ 'blogs.read_more' | t }} {% render 'icon', name: 'arrow', size: 15 %}</span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="muted">{{ 'blogs.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes from the studio" },
    { "type": "text", "id": "default_tag", "label": "Fallback tag", "default": "Journal" },
    { "type": "range", "id": "posts_to_show", "min": 1, "max": 6, "step": 1, "label": "Posts to show", "default": 3 }
  ],
  "presets": [{ "name": "Journal" }]
}
{% endschema %}
