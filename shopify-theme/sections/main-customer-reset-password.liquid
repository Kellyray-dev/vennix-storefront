<section class="auth page-width">
  <div class="auth__panel">
    <p class="eyebrow">{{ 'customer.reset_password.eyebrow' | t }}</p>
    <h1>{{ 'customer.reset_password.title' | t }}</h1>
    <p class="auth__lead">{{ 'customer.reset_password.subtext' | t: email: email }}</p>

    {%- form 'reset_customer_password', class: 'auth__form' -%}
      {%- if form.errors -%}
        <p class="form-msg is-error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="field">
        <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button class="button button--primary button--lg" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
