<div class="announcement-bar" data-announcement-bar
     data-rotate-speed="{{ section.settings.rotate_speed | times: 1000 }}"
     style="--announcement-bg: {{ section.settings.background }}; --announcement-fg: {{ section.settings.text_color }};">
  <div class="page-width announcement-bar__inner">
    <div class="announcement-bar__track" data-announcement-track>
      {%- for block in section.blocks -%}
        <p class="announcement-bar__item{% if forloop.first %} is-active{% endif %}" data-announcement-item {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>

    {%- if section.settings.dismissible -%}
      <button class="announcement-bar__close" type="button" data-announcement-close aria-label="{{ 'general.accessibility.dismiss' | t }}">
        {% render 'icon', name: 'close', size: 14 %}
      </button>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#191614" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F4EFE7" },
    { "type": "range", "id": "rotate_speed", "min": 0, "max": 12, "step": 1, "unit": "s", "label": "Rotate every", "default": 5 },
    { "type": "checkbox", "id": "dismissible", "label": "Dismissible", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Announcement bar", "blocks": [{ "type": "message" }, { "type": "message" }, { "type": "message" }] }
  ]
}
{% endschema %}
