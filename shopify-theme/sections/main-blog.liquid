<section class="blog page-width">
  <nav class="breadcrumbs" aria-label="{{ 'general.accessibility.breadcrumb' | t }}">
    <ol>
      <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
      <li><span aria-current="page">{{ blog.title }}</span></li>
    </ol>
  </nav>

  <header class="blog__head">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ blog.title }}</h1>
    {%- if section.settings.intro != blank -%}<p class="blog__intro">{{ section.settings.intro }}</p>{%- endif -%}
  </header>

  {%- if blog.all_tags.size > 0 -%}
    <ul class="chip-list blog__tags">
      <li><a class="chip{% unless current_tags %} is-active{% endunless %}" href="{{ blog.url }}">{{ 'blogs.all' | t }}</a></li>
      {%- for tag in blog.all_tags -%}
        <li><a class="chip{% if current_tags contains tag %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- paginate blog.articles by 9 -%}
    <ul class="journal__list journal__list--grid">
      {%- for article in blog.articles -%}
        <li class="post-card">
          <a href="{{ article.url }}">
            <span class="post-card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="post-card__body">
              <span class="post-card__meta">
                <span class="post-card__tag">{{ article.tags.first | default: 'Journal' }}</span>
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d %b %Y' }}</time>
              </span>
              <strong class="post-card__title">{{ article.title }}</strong>
              <span class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</span>
              <span class="link-arrow">{{ 'blogs.read_more' | t }} {% render 'icon', name: 'arrow', size: 15 %}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The journal" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Fit notes, fabric deep-dives and the people we make for." }
  ]
}
{% endschema %}
