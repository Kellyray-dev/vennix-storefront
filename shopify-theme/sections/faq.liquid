<section class="faq">
  <div class="page-width faq__inner">
    <div class="faq__intro">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.body }}</div>
      {%- if section.settings.link != blank -%}
        <a class="button button--outline" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="faq__list" data-accordion>
      {%- for block in section.blocks -%}
        <details class="accordion__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Answers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Still stuck? Our studio team replies within one business day.</p>" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Contact us" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does the sizing run?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>True to size with a relaxed shoulder. If you're between sizes and want a closer fit, size down.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
