<section class="auth page-width">
  <div class="auth__panel" id="login">
    <p class="eyebrow">{{ 'customer.login.eyebrow' | t }}</p>
    <h1>{{ 'customer.login.title' | t }}</h1>
    <p class="auth__lead">{{ 'customer.login.subtext' | t }}</p>

    {%- form 'customer_login', novalidate: 'novalidate', class: 'auth__form' -%}
      {%- if form.errors -%}
        <p class="form-msg is-error" role="alert">
          {% render 'icon', name: 'info', size: 16 %}
          {{ form.errors.messages['form'] | default: form.errors | default_errors }}
        </p>
      {%- endif -%}

      <div class="field">
        <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
        <input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required
               {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
      </div>

      {%- if form.password_needed -%}
        <div class="field">
          <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
          <input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required>
        </div>
      {%- endif -%}

      <div class="auth__row">
        <button class="button button--primary button--lg" type="submit">{{ 'customer.login.sign_in' | t }}</button>
        <a class="link-inline" href="#recover" data-recover-open>{{ 'customer.login.forgot_password' | t }}</a>
      </div>
    {%- endform -%}

    <div class="auth__alt">
      <p>{{ 'customer.login.new_customer' | t }}</p>
      <a class="button button--outline" href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
    </div>
  </div>

  <div class="auth__panel auth__panel--recover" id="recover" hidden>
    <p class="eyebrow">{{ 'customer.recover_password.eyebrow' | t }}</p>
    <h2>{{ 'customer.recover_password.title' | t }}</h2>
    <p class="auth__lead">{{ 'customer.recover_password.subtext' | t }}</p>

    {%- form 'recover_customer_password', class: 'auth__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-msg is-ok" role="status">{% render 'icon', name: 'check', size: 16 %} {{ 'customer.recover_password.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="form-msg is-error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="field">
        <label for="RecoverEmail">{{ 'customer.recover_password.email' | t }}</label>
        <input id="RecoverEmail" type="email" name="email" autocomplete="email" required>
      </div>
      <button class="button button--primary" type="submit">{{ 'customer.recover_password.submit' | t }}</button>
      <a class="link-inline" href="#login" data-recover-close>{{ 'customer.recover_password.cancel' | t }}</a>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Customer login", "settings": [] }
{% endschema %}
