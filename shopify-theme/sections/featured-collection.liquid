{%- assign col = section.settings.collection -%}
{%- assign products = col.products -%}
{%- if products.size == 0 -%}{%- assign products = collections[settings.home_featured_collection].products -%}{%- endif -%}

<section class="featured-collection">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | default: col.title | default: 'New in' }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>

      <div class="section-head__actions">
        {%- if section.settings.show_arrows and products.size > 4 -%}
          <button class="icon-button" type="button" data-rail-prev aria-label="{{ 'general.accessibility.previous' | t }}">
            {% render 'icon', name: 'arrow-left', size: 16 %}
          </button>
          <button class="icon-button" type="button" data-rail-next aria-label="{{ 'general.accessibility.next' | t }}">
            {% render 'icon', name: 'arrow', size: 16 %}
          </button>
        {%- endif -%}
        {%- if section.settings.link != blank or col.url -%}
          <a class="link-arrow" href="{{ section.settings.link | default: col.url }}">
            {{ section.settings.link_label }} {% render 'icon', name: 'arrow', size: 15 %}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if products.size == 0 -%}
      <ul class="product-grid product-grid--4">
        {%- for i in (1..4) -%}
          <li class="product-card">
            <div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="product-card__body"><h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
            <span class="price__current">{{ 4900 | money }}</span></div>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="product-grid product-grid--4{% if section.settings.use_rail %} product-grid--rail{% endif %}" {% if section.settings.use_rail %}data-rail{% endif %}>
        {%- for product in products limit: section.settings.products_to_show -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fresh cut" },
    { "type": "text", "id": "heading", "label": "Heading override" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 2, "label": "Products to show", "default": 8 },
    { "type": "checkbox", "id": "use_rail", "label": "Horizontal rail", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show rail arrows", "default": true },
    { "type": "url", "id": "link", "label": "Header link" },
    { "type": "text", "id": "link_label", "label": "Header link label", "default": "Shop all" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
