{%- comment -%}Inline icon set. Usage: {% render 'icon', name: 'cart', size: 20, class: 'x' %}{%- endcomment -%}
{%- assign s = size | default: 18 -%}
<svg class="icon icon--{{ name }} {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
