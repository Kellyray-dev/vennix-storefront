    {%- when 'bag' -%}<path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'chevron' -%}<path d="M9 5l7 7-7 7"/>
    {%- when 'chevron-down' -%}<path d="M5 9l7 7 7-7"/>
    {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}<path d="M19 12H5M11 18l-6-6 6-6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'trash' -%}<path d="M5 7h14M10 7V5h4v2M7 7l1 13h8l1-13"/>
    {%- when 'check' -%}<path d="M5 13l4.5 4.5L19 7"/>
