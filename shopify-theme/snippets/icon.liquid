    {%- when 'sort' -%}<path d="M7 5v14M4 16l3 3 3-3M17 19V5M14 8l3-3 3 3"/>
    {%- when 'box' -%}<path d="M12 3.5l8 4.2v8.6l-8 4.2-8-4.2V7.7l8-4.2z"/><path d="M4 7.7l8 4.2 8-4.2M12 11.9V20"/>
    {%- when 'tag' -%}<path d="M4 11.2V4h7.2l8.6 8.6-7.2 7.2L4 11.2z"/><circle cx="8.2" cy="8.2" r="1.4"/>
    {%- when 'users' -%}<circle cx="9" cy="9" r="3.2"/><path d="M3.5 19c.9-3.1 3-4.6 5.5-4.6s4.6 1.5 5.5 4.6"/><path d="M16 7.2a3 3 0 0 1 0 5.6M17.5 19c-.3-1.6-.9-2.9-1.7-3.9"/>
    {%- when 'chart' -%}<path d="M4 20V4M4 20h16"/><path d="M8 17v-5M12.5 17V8M17 17v-7"/>
    {%- when 'grid' -%}<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>
    {%- when 'list' -%}<path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/>
    {%- when 'snow' -%}<path d="M12 3v18M4.5 7.5l15 9M19.5 7.5l-15 9"/>
    {%- when 'wind' -%}<path d="M3 8h11a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h8"/>
    {%- when 'play' -%}<path d="M8 5.5l11 6.5-11 6.5z"/>
    {%- when 'external' -%}<path d="M14 4h6v6M20 4l-9 9M18 14v5H5V6h5"/>
