    {%- when 'repair' -%}<path d="M15 4.5a5 5 0 0 0-5.7 7.6L4 17.4V20h2.6l5.3-5.3A5 5 0 0 0 19.5 9L17 11.5 13 11l-.5-4L15 4.5z"/>
    {%- when 'star' -%}<path d="M12 3.6l2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.8l5.9-.8L12 3.6z" fill="currentColor" stroke="none"/>
