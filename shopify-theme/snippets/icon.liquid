    {%- when 'settings' -%}<circle cx="12" cy="12" r="3"/><path d="M12 3.5v2M12 18.5v2M4.9 7.5l1.7 1M17.4 15.5l1.7 1M4.9 16.5l1.7-1M17.4 8.5l1.7-1"/>
    {%- when 'tiktok' -%}<path d="M15 4.5c.4 2 1.7 3.4 3.7 3.7v2.4c-1.4 0-2.7-.4-3.7-1.2v5.6a4.9 4.9 0 1 1-4.9-4.9c.3 0 .5 0 .8.1v2.5a2.4 2.4 0 1 0 1.7 2.3V4.5Z"/>
    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="8.5"/><path d="M10.4 19.5 12.6 11"/><path d="M9.8 13.4a3.2 3.2 0 1 1 5.2 1.6c-1 .8-2.4.6-3-.3"/>
    {%- when 'linkedin' -%}<rect x="3.8" y="3.8" width="16.4" height="16.4" rx="2.6"/><path d="M8 10.6v6M8 7.6v.01M12 16.6v-3.4a2 2 0 0 1 4 0v3.4"/>
    {%- when 'instagram' -%}<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><path d="M16.8 7.4h.01"/>
    {%- else -%}<circle cx="12" cy="12" r="8.5"/>
  {%- endcase -%}
</svg>
