{%- comment -%}Shared address form fields. Accepts: form{%- endcomment -%}
<div class="field field--half">
  <label for="{{ form.id }}-first">{{ 'customer.addresses.first_name' | t }}</label>
  <input id="{{ form.id }}-first" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
</div>
<div class="field field--half">
  <label for="{{ form.id }}-last">{{ 'customer.addresses.last_name' | t }}</label>
  <input id="{{ form.id }}-last" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
</div>
<div class="field">
  <label for="{{ form.id }}-company">{{ 'customer.addresses.company' | t }}</label>
  <input id="{{ form.id }}-company" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization">
</div>
<div class="field">
  <label for="{{ form.id }}-address1">{{ 'customer.addresses.address1' | t }}</label>
  <input id="{{ form.id }}-address1" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required>
</div>
<div class="field">
  <label for="{{ form.id }}-address2">{{ 'customer.addresses.address2' | t }}</label>
  <input id="{{ form.id }}-address2" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="field field--half">
  <label for="{{ form.id }}-city">{{ 'customer.addresses.city' | t }}</label>
  <input id="{{ form.id }}-city" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
</div>
<div class="field field--half">
  <label for="{{ form.id }}-country">{{ 'customer.addresses.country' | t }}</label>
  <select id="{{ form.id }}-country" name="address[country]" data-default="{{ form.country }}">{{ country_option_tags }}</select>
</div>
<div class="field field--half">
  <label for="{{ form.id }}-province">{{ 'customer.addresses.province' | t }}</label>
  <input id="{{ form.id }}-province" type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
</div>
<div class="field field--half">
  <label for="{{ form.id }}-zip">{{ 'customer.addresses.zip' | t }}</label>
  <input id="{{ form.id }}-zip" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
</div>
<div class="field field--half">
  <label for="{{ form.id }}-phone">{{ 'customer.addresses.phone' | t }}</label>
  <input id="{{ form.id }}-phone" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>
<label class="checkbox field--half">
  {{ form.set_as_default_checkbox }}
  <span class="checkbox__box">{% render 'icon', name: 'check', size: 12 %}</span>
  <span class="checkbox__label">{{ 'customer.addresses.set_default' | t }}</span>
</label>
